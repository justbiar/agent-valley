# Allow list: only the code we build goes to GitHub.
/*
!/.gitignore
!/index.html
!/agent-valley.html
!/buildings.html
!/engine.js
!/assets/
!/app/
!/contracts/
!/README.md
!/AGENTS.md
!/LICENSE
!/Dockerfile
!/.dockerignore
!/docker-compose.yml
!/.github/

# Only the images the pages use
/assets/*
!/assets/hero.jpg
!/assets/build.jpg
!/assets/towers.jpg
!/assets/fog.jpg
!/assets/av.css
!/assets/avatar.js

# Never: Markdown, env files, local state, build output
*.md
!/README.md
!/AGENTS.md
.env
.env.*
app/data/
**/target/
.DS_Store
